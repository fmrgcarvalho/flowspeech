<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>FlowSpeech.App</RootNamespace>
    <AssemblyName>FlowSpeech</AssemblyName>
    <UseWPF>true</UseWPF>
    <!-- Só para o NotifyIcon (ícone na barra de tarefas). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\flowspeech.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <!-- Evita ambiguidades WPF vs WinForms (Application, MessageBox, ...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FlowSpeech.Core\FlowSpeech.Core.csproj" />
    <ProjectReference Include="..\FlowSpeech.Platform.Windows\FlowSpeech.Platform.Windows.csproj" />
    <ProjectReference Include="..\FlowSpeech.Transcription\FlowSpeech.Transcription.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\flowspeech.ico" />
    <None Update="Assets\flowspeech.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
